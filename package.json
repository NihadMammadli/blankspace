{
  "name": "blankspace",
  "version": "1.0.0",
  "private": true,
  "description": "blankspace — event venues in the Brussels EU Quarter. Next.js static export.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/content-check.mjs && next build && node scripts/postbuild.mjs",
    "start": "npx serve out -l 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "content:check": "node scripts/content-check.mjs",
    "images": "node scripts/images.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
